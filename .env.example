WEBSITE_URL=https://www.buyyourdevice.co.za
WEBSITE_NAME=www.buyyourdevice.co.za_pg1

EMAIL_RECIPIENTS=person1@example.com,person2@example.com
PRIVATE_EMAIL_RECIPIENTS=person1@example.com
PRIVATE_EMAIL_TRIGGER=ACTIVATE_PRIVATE_EMAIL
PRIVATE_EMAIL_MODE=
NOT_LAPTOPS=false

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=replace_with_gmail_app_password

ALERT_SUBJECT=Laptop Sales GO NOW!!!
ALERT_MESSAGE_TEMPLATE=BUY YOUR DEVICE NOW!!!! Navigate to\n\n{website}\n\n *** If you don't want, buy for RogerB ***

CHECK_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
ALLOW_INSECURE_SSL_FALLBACK=true
CACHE_DIR=cache
